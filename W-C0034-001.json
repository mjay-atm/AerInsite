{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Future","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-08-09T17:30:00+08:00","onset":"2026-08-09T17:30:00+08:00","expires":"2026-08-09T21:30:00+08:00","senderName":"中央氣象署","headline":"海上颱風警報","description":{"section":[{"title":"命名與位置","value":"輕度颱風 白海豚（國際命名 DOLPHIN）9日17時的中心位置在北緯 28.1 度，東經 121.3 度，即在馬祖的北北東方約 260 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 968 百帕，近中心最大風速每秒 30 公尺（約每小時 108 公里），相當於 11 級風，瞬間最大陣風每秒 38 公尺（約每小時 137 公里），相當於 13 級風，七級風暴風半徑 200 公里，十級風暴風半徑 70 公里。"},{"title":"移速與預測","value":"以每小時17公里速度，向西北西轉西北進行，預測10日17時的中心位置在北緯 29.4 度，東經 117.6 度，即在馬祖的北北西方約 430 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第13號颱風已減弱為輕度颱風，過去3小時暴風圈略為縮小，目前中心在馬祖北北東方，向西北西轉西北移動，其暴風圈正逐漸通過臺灣北部海面，對臺灣北部海面構成威脅，預計此颱風強度有持續減弱且暴風圈有縮小的趨勢。"},{"title":"警戒區域及事項","value":"海上：臺灣北部海面航行及作業船隻應嚴加戒備。"},{"title":"大雨特報","value":"第13號颱風及其外圍環流影響，今(9)日臺北市山區已有局部大豪雨，桃園市、新竹縣地區及苗栗縣山區、臺中市山區已有局部豪雨發生；今(9日)晚至明(10)日第13號颱風外圍環流及西南風影響，易有短延時強降雨，臺中、南投、嘉義以南地區及苗栗以北山區仍有局部大雨發生的機率，請注意坍方、落石、土石流及溪水暴漲，低窪地區請慎防積水。"},{"title":"強風特報","value":"今(9日)晚第13號颱風及其外圍環流影響，連江縣、新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、屏東縣、綠島、蘭嶼局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)；明(10)日西南風影響，桃園市、新竹市、新竹縣、苗栗縣、臺中市、彰化縣、雲林縣、嘉義縣、屏東縣、連江縣、綠島、蘭嶼亦有平均風6級以上或陣風8級以上發生的機率(黃色燈號)。"},{"title":"注意事項","value":"＊今(9日)晚至明(10)日基隆北海岸、東半部(含蘭嶼、綠島)、恆春半島、中部以北沿海及馬祖、澎湖易有長浪發生，臺灣附近各沿海風浪仍大，浪高約2至4公尺，請避免前往海邊活動。＊基隆北海岸適逢大潮，滿潮前後沿海低窪地區需留意海水倒灌及積淹水。＊高溫資訊：西南風沉降影響，天氣高溫炎熱，東部及東南部地區有焚風發生的機率，明(10)日白天臺東縣為橙色燈號，有連續出現36度高溫的機率，請加強注意。臺北市、新北市、桃園市、花蓮縣為黃色燈號，請注意。＊自7日0時至9日17時出現較大累積雨量如下:臺北市小油坑410.0毫米，臺中市雪山橋339.5毫米，新竹縣樂山林道6K 278.5毫米，苗栗縣雪見248.0毫米，桃園市國一S072K 214.0毫米；較大陣風區域如下：彭佳嶼13級，蘭嶼11級，基隆10級。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"18"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"13"},{"title":"颱風資訊","analysis":{"time":"2026-08-09T09:00:00+00:00","position":"28.10,121.30","gust":{"value":"38","unit":"m/s"},"pressure":{"value":"968","unit":"hPa"},"scale":[{"value":"輕度颱風","lang":"zh-TW"},{"value":"SEVERE TROPICAL STORM","lang":"en"}],"max_winds":{"value":"30","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"prediction":{"time":"2026-08-10T09:00:00+00:00","position":"29.40,117.60","gust":{"value":"25","unit":"m/s"},"pressure":{"value":"988","unit":"hPa"},"max_winds":{"value":"18","unit":"m/s"},"radius_of_15mps":{"value":"100","unit":"km"}},"typhoon_name":"DOLPHIN","cwa_typhoon_name":"白海豚"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"臺灣北部海面","polygon":"25.000032,122.000000 25.000032,121.997200 25.006732,122.000000 25.114732,121.881700 25.126532,121.788600 25.138932,121.734700 25.168632,121.681300 25.214432,121.636700 25.249432,121.616900 25.259132,121.608900 25.267232,121.598000 25.275832,121.583300 25.283632,121.563200 25.282232,121.515300 25.277332,121.500000 25.2704