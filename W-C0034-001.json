4)日巴士海峽、臺灣東半部海面及北部海面風浪將逐漸增大，晚起巴士海峽、東南部海面(含蘭嶼、綠島)及北部海面浪高可達3公尺以上。今晚起東半部(含蘭嶼、綠島)及恆春半島沿海有長浪發生的機率，前往海邊活動請注意安全。＊高溫資訊：颱風外圍沉降影響，天氣高溫炎熱，北部地區有焚風發生的機率，今(24)日白天臺南市、屏東縣、花蓮縣、臺東縣為橙色燈號，有連續出現36度高溫的機率，請加強注意；臺北市、新北市、桃園市、彰化縣、雲林縣、嘉義市、嘉義縣為黃色燈號，請注意。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"3"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"12"},{"title":"颱風資訊","analysis":{"time":"2026-07-23T21:00:00+00:00","position":"18.40,124.30","gust":{"value":"25","unit":"m/s"},"pressure":{"value":"998","unit":"hPa"},"scale":[{"value":"輕度颱風","lang":"zh-TW"},{"value":"TROPICAL STORM","lang":"en"}],"max_winds":{"value":"18","unit":"m/s"},"radius_of_15mps":{"value":"60","unit":"km"}},"prediction":{"time":"2026-07-24T21:00:00+00:00","position":"20.80,118.80","gust":{"value":"38","unit":"m/s"},"pressure":{"value":"975","unit":"hPa"},"max_winds":{"value":"30","unit":"m/s"},"radius_of_15mps":{"value":"150","unit":"km"}},"typhoon_name":"NOUL","cwa_typhoon_name":"紅霞"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"巴士海峽東部","polygon":"20.000032,121.500000 20.000032,121.000000 20.500032,121.000000 21.000032,121.000000 21.500032,121.000000 22.000032,121.000000 22.000032,121.500000 22.000032,122.000000 22.000032,122.500000 22.000032,123.000000 21.500032,123.000000 21.000032,123.000000 20.500032,123.000000 20.000032,123.000000 20.000032,122.500000 20.000032,122.000000 20.000032,121.500000"},{"areaDesc":"巴士海峽西部","polygon":"20.000032,119.500000 20.000032,119.000000 20.500032,119.000000 21.000032,119.000000 21.500032,119.000000 22.000032,119.000000 22.000032,119.500000 22.000032,120.000000 22.000032,120.500000 22.000032,120.692500 21.943332,120.699000 21.932232,120.709000 21.927932,120.719600 21.927732,120.824200 22.000032,120.862100 22.000032,121.000000 21.500032,12