{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Future","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-08-27T23:30:00+08:00","onset":"2026-08-27T23:30:00+08:00","expires":"2026-08-28T03:30:00+08:00","senderName":"中央氣象署","headline":"海上颱風警報","description":{"section":[{"title":"命名與位置","value":"中度颱風 沙德爾（國際命名 SAUDEL）27日23時的中心位置在北緯 28.0 度，東經 123.0 度，即在馬祖的東北方約 370 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 970 百帕，近中心最大風速每秒 33 公尺（約每小時 119 公里），相當於 12 級風，瞬間最大陣風每秒 43 公尺（約每小時 155 公里），相當於 14 級風，七級風暴風半徑 200 公里，十級風暴風半徑 60 公里。"},{"title":"移速與預測","value":"以每小時20轉27公里速度，向西進行，預測28日23時的中心位置在北緯 27.4 度，東經 117.5 度，即在馬祖的西北西方約 280 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第18號颱風過去3小時強度略為減弱，目前中心在馬祖東北方海面，向西移動，其暴風圈已進入臺灣北部海面，對臺灣北部海面(馬祖近海)構成威脅；預計此颱風未來強度有持續減弱趨勢。"},{"title":"警戒區域及事項","value":"海上：臺灣北部海面航行及作業船隻應嚴加戒備。"},{"title":"大雨特報","value":"西南風影響，易有短延時強降雨，今(27日)晚至明(28)日南部地區及嘉義山區有局部大雨發生的機率，請注意雷擊及強陣風，連日降雨，山區請慎防坍方、落石及溪水暴漲，低窪地區請慎防積水。"},{"title":"強風特報","value":"西南風偏強，今(27日)晚至明(28)日基隆市、新北市、桃園市、新竹縣市、苗栗縣、屏東縣、花蓮縣、連江縣及蘭嶼局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意。"},{"title":"注意事項","value":"＊今(27日)晚至明(28)日基隆北海岸、東半部沿海(含蘭嶼、綠島)、恆春半島及馬祖易有長浪發生，臺灣附近各海面風浪逐漸增大，其中基隆北海岸、馬祖、蘭嶼及綠島沿海有3公尺以上大浪，前往海邊活動請注意安全。 ＊適逢大潮，滿潮前後沿海低窪地區需留意強降雨導致積淹水。  ＊天氣高溫炎熱及西南風沉降影響，明(28)日白天臺北市、新北市、宜蘭縣、花蓮縣、臺東縣、金門縣為黃色燈號，請注意。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"6"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"18"},{"title":"颱風資訊","analysis":{"time":"2026-08-27T15:00:00+00:00","position":"28.00,123.00","gust":{"value":"43","unit":"m/s"},"pressure":{"value":"970","unit":"hPa"},"scale":[{"value":"中度颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"33","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"prediction":{"time":"2026-08-28T15:00:00+00:00","position":"27.40,117.50","gust":{"value":"23","unit":"m/s"},"pressure":{"value":"1000","unit":"hPa"},"max_winds":{"value":"15","unit":"m/s"},"radius_of_15mps":{"value":"-","unit":"km"}},"typhoon_name":"SAUDEL","cwa_typhoon_name":"沙德爾"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"臺灣北部海面","polygon":"26.000032,120.000000 26.000032,119.696400 26.013432,119.682800 26.043132,119.572100 26.040232,119.516900 26.022532,119.500000 26.050432,119.500000 26.055832,119.507500 26.173932,119.593000 26.256532,119.635400 26.281832,119.668900 26.289632,119.768000 26.280532,119.792800 26.303332,119.793200 26.322632,119.816900 26.322732,119.850100 26.310532,119.884100 26.348732,119.933900 26.367732,119.948900 26.418632,119.818700 26.398032,119.788300 26.365832,119.756400 26.332032,119.737400 26.317932,119.689400 26.338632,119.658000 26.443332,119.565500 26.473832,119.577500 26.492732,119.653000 26.435232,119.734400 26.407532,119.766100 26.409132,119.788600 26.442232,119.820400 