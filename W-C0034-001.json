{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Future","severity":"Minor","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-07-09T14:30:00+08:00","onset":"2026-07-09T14:30:00+08:00","expires":"2026-07-09T18:30:00+08:00","senderName":"中央氣象署","headline":"海上颱風警報","description":{"section":[{"title":"命名與位置","value":"強烈颱風 巴威（國際命名 BAVI）9日14時的中心位置在北緯 18.7 度，東經 129.0 度，即在鵝鑾鼻的東南東方約 920 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 925 百帕，近中心最大風速每秒 51 公尺（約每小時 184 公里），相當於 16 級風，瞬間最大陣風每秒 63 公尺（約每小時 227 公里），相當於 17 級風以上，七級風暴風半徑 380 公里，十級風暴風半徑 180 公里。"},{"title":"移速與預測","value":"以每小時20轉23公里速度，向北北西轉西北進行，預測10日14時的中心位置在北緯 22.1 度，東經 126.2 度，即在鵝鑾鼻的東方約 550 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第9號颱風目前中心在鵝鑾鼻東南東方海面，向北北西轉西北移動，對巴士海峽、 臺灣東南部海面及臺灣東北部海面將構成威脅。"},{"title":"警戒區域及事項","value":"海上：臺灣東北部海面、臺灣東南部海面(含蘭嶼、綠島)、巴士海峽航行及作業船隻應嚴加戒備。"},{"title":"強風特報","value":"颱風外圍環流影響，9日至10日晚上蘭嶼、綠島、基隆市、臺北市、新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、彰化縣、雲林縣、嘉義縣、臺南市、高雄市、屏東縣、宜蘭縣、花蓮縣、澎湖縣、金門縣、連江縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意。"},{"title":"注意事項","value":"＊今(9)日至明(10)日北部、東半部沿海(含蘭嶼、綠島)、恆春半島及馬祖易有長浪發生，臺灣附近各海面風浪將逐漸增大至3公尺以上，尤其東半部(含蘭嶼、綠島)及恆春半島沿海有6公尺以上巨浪，請避免前往海邊活動。＊各地天氣高溫炎熱，金門縣已有焚風發生，今(9)日白天屏東縣為橙色燈號，有38度極端高溫出現的機率；新北市、彰化縣、雲林縣、嘉義市、嘉義縣、臺南市、高雄市、花蓮縣為橙色燈號，有連續出現36度高溫的機率，請加強注意。臺北市、宜蘭縣、金門縣為黃色燈號，請注意。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"1"},{"title":"警報類別","value":"SEA"},{"title":"颱風編號","value":"9"},{"title":"颱風資訊","analysis":{"time":"2026-07-09T06:00:00+00:00","position":"18.70,129.00","gust":{"value":"63","unit":"m/s"},"pressure":{"value":"925","unit":"hPa"},"scale":[{"value":"強烈颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"51","unit":"m/s"},"radius_of_15mps":{"value":"380","unit":"km"}},"prediction":{"time":"2026-07-10T06:00:00+00:00","position":"22.10,126.20","gust":{"value":"63","unit":"m/s"},"pressure":{"value":"925","unit":"hPa"},"max_winds":{"value":"51","unit":"m/s"},"radius_of_15mps":{"value":"380","unit":"km"}},"typhoon_name":"BAVI","cwa_typhoon_name":"巴威"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上颱風警報"},{"valueName":"alert_color","value":"橙色"},{"valueName":"website_color","value":"255,128,0"}],"area":[{"areaDesc":"巴士海峽東部","polygon":"20.000032,121.500000 20.000032,121.000000 20.500032,121.000000 21.000032,121.000000 21.500032,121.000000 22.000032,121.000000 22.000032,121.500000 22.000032,122.000000 22.000032,122.500000 22.000032,123.000000 21.500032,123.000000 21.000032,123.000000 20.500032,123.000000 20.000032,123.000000 20.000032,122.500000 20.000032,122.000000 20.000032,121.500000"},{"areaDesc":"臺灣東北部海面","polygon":"23.500032,122.000000 23.500032,121.500000 23.701432,121.536900 23.900032,121.596400 23.983332,121.611400 24.000032,121.612900 24.034132,121.616100 24.041632,121.609200 24.058332,121.602600 24.083232,121.606200 24.184732,121.659400 24.205032,121.676100 24.286432,121.745000 24.292732,121.753100 24.301632,121.772500 24.3