燈號)，請注意。"},{"title":"注意事項","value":"＊今(25)日巴士海峽、東南部(含蘭嶼、綠島)、西南部、北部及澎湖、金門附近海面易有3公尺左右大浪；東半部(含蘭嶼、綠島)、恆春半島、西南部沿海及澎湖有長浪發生的機率，前往海邊活動請注意安全。＊高溫資訊：颱風外圍環流沉降影響，北部地區有焚風發生的機率，今(25)日白天臺北市、新北市、桃園市為黃色燈號，請注意。＊自7月24日0時至25日8時較大累積雨量如下：屏東縣泰武207毫米。＊此為第12號颱風最後一次報告。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"12"},{"title":"警報類別","value":"END"},{"title":"颱風編號","value":"12"},{"title":"颱風資訊","analysis":{"time":"2026-07-25T00:00:00+00:00","position":"20.80,117.90","gust":{"value":"43","unit":"m/s"},"pressure":{"value":"972","unit":"hPa"},"scale":[{"value":"中度颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"33","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"prediction":{"time":"2026-07-26T00:00:00+00:00","position":"23.50,114.50","gust":{"value":"45","unit":"m/s"},"pressure":{"value":"965","unit":"hPa"},"max_winds":{"value":"35","unit":"m/s"},"radius_of_15mps":{"value":"200","unit":"km"}},"typhoon_name":"NOUL","cwa_typhoon_name":"紅霞"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"解除颱風警報"}],"area":[{"areaDesc":"基隆市","geocode":{"valueName":"Taiwan_Geocode_112","value":"10017000"}},{"areaDesc":"臺北市","geocode":{"valueName":"Taiwan_Geocode_112","value":"63000000"}},{"areaDesc":"新北市","geocode":{"valueName":"Taiwan_Geocode_112","value":"65000000"}},{"areaDesc":"宜蘭縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10002000"}},{"areaDesc":"桃園市","geocode":{"valueName":"Taiwan_Geocode_112","value":"68000000"}},{"areaDesc":"新竹縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10004000"}},{"areaDesc":"新竹市","geocode":{"valueName":"Taiwan_Geocode_112","value":"10018000"}},{"areaDesc":"花蓮縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10015000"}},{"areaDesc":"苗栗縣","geocode":{"valueName":"Taiwan_Geocode_112","value":"10005000"}},{"areaDesc":"臺中市","geocode":{"valueName":"Taiwan_Geocode_112","value":"66000000"}},{"areaDesc":"彰化縣","geocode":{"valueName":"Taiwan_Geocode_112","valu