{"success":"true","result":{"resource_id":"W-C0034-001","fields":[{"id":"language","type":"String"},{"id":"category","type":"String"},{"id":"event","type":"String"},{"id":"responseType","type":"String"},{"id":"urgency","type":"String"},{"id":"severity","type":"String"},{"id":"certainty","type":"String"},{"id":"valueName","type":"String"},{"id":"value","type":"String"},{"id":"effective","type":"String"},{"id":"onset","type":"String"},{"id":"expires","type":"String"},{"id":"senderName","type":"String"},{"id":"headline","type":"String"},{"id":"description","type":"String"},{"id":"title","type":"String"},{"id":"typhoon_name","type":"String"},{"id":"cwa_typhoon_name","type":"String"},{"id":"time","type":"String"},{"id":"position","type":"String"},{"id":"unit","type":"String"},{"id":"lang","type":"String"},{"id":"web","type":"String"},{"id":"areaDesc","type":"String"},{"id":"polygon","type":"String"}]},"records":{"info":[{"language":"zh-TW","category":"Met","event":"颱風","responseType":"Monitor","urgency":"Immediate","severity":"Moderate","certainty":"Likely","eventCode":{"valueName":"profile:CAP-TWP:Event:1.0","value":"typhoon"},"effective":"2026-07-12T02:30:00+08:00","onset":"2026-07-12T02:30:00+08:00","expires":"2026-07-12T06:30:00+08:00","senderName":"中央氣象署","headline":"海上陸上颱風警報","description":{"section":[{"title":"命名與位置","value":"中度颱風 巴威（國際命名 BAVI）12日2時的中心位置在北緯 28.6 度，東經 120.6 度，即在馬祖的北北東方約 280 公里之處。"},{"title":"強度與半徑","value":"中心氣壓 970 百帕，近中心最大風速每秒 33 公尺（約每小時 119 公里），相當於 12 級風，瞬間最大陣風每秒 43 公尺（約每小時 155 公里），相當於 14 級風，七級風暴風半徑 280 公里，十級風暴風半徑 90 公里。"},{"title":"移速與預測","value":"以每小時26轉14公里速度，向西北轉北北西進行，預測13日2時的中心位置在北緯 32.2 度，東經 117.5 度，即在上海的西北西方約 380 公里之處。"},{"title":"颱風動態","value":"根據最新資料顯示，第9號颱風過去3小時強度減弱且暴風圈縮小，目前中心在馬祖北北東方，向西北轉北北西移動，對馬祖及臺灣北部海面仍構成威脅，預計此颱風未來強度有減弱的趨勢。"},{"title":"警戒區域及事項","value":"陸上：馬祖應嚴加戒備。海上：臺灣北部海面航行及作業船隻應嚴加戒備。"},{"title":"豪雨特報","value":"颱風及其外圍環流影響，易有短延時強降雨，今(12)日苗栗縣山區、臺中市山區、南投縣山區、高雄市山區及屏東縣山區有局部大雨或豪雨，苗栗以南地區、桃竹山區及馬祖有局部大雨發生的機率，山區請慎防坍方、落石，土石流及山洪暴發，低窪地區請嚴防積淹水，民眾應避免前往山區及溪流活動。"},{"title":"強風特報","value":"颱風及其外圍環流影響，今(12)日綠島、連江縣局部地區有平均風9級以上或陣風11級以上發生的機率(橙色燈號)，基隆市、臺北市、新北市、桃園市、新竹市、新竹縣、苗栗縣、臺中市、南投縣、彰化縣、雲林縣、嘉義縣、臺南市、高雄市、屏東縣、宜蘭縣、花蓮縣、臺東縣(含蘭嶼)、澎湖縣、金門縣局部地區有平均風6級以上或陣風8級以上發生的機率(黃色燈號)，請注意防範。"},{"title":"注意事項","value":"＊今(12)日臺灣附近各沿海及離島仍易有3公尺以上浪高，北部、東半部沿海(含蘭嶼、綠島)、恆春半島及馬祖並有長浪發生，請避免前往海邊活動。＊室外懸掛物、招牌、圍籬及鷹架等應加強固牢，陽台之盆景等應妥善放置。＊自9日0時至12日2時出現較大累積雨量如下：苗栗縣拉庫斯767.0毫米，新竹縣白蘭742.0毫米，臺中市雪山橋605.0毫米，桃園市蘇樂556.5毫米，雲林縣草嶺石壁553.5毫米，新北市福山466.0毫米，南投縣杉林溪大飯店442.5毫米，宜蘭縣明池430.0毫米，嘉義縣碧湖402.5毫米，屏東縣泰武396.0毫米，臺北市陽明山367.5毫米，高雄市排雲215毫米，新竹市國三S103K 205.5毫米；較大陣風區域如下：蘭嶼14級，彭佳嶼12級，基隆、梧棲、東吉島、新屋10級。"}],"typhoon-info":[{"section":[{"title":"警報報數","value":"21"},{"title":"警報類別","value":"LAND"},{"title":"颱風編號","value":"9"},{"title":"颱風資訊","analysis":{"time":"2026-07-11T18:00:00+00:00","position":"28.60,120.60","gust":{"value":"43","unit":"m/s"},"pressure":{"value":"970","unit":"hPa"},"scale":[{"value":"中度颱風","lang":"zh-TW"},{"value":"TYPHOON","lang":"en"}],"max_winds":{"value":"33","unit":"m/s"},"radius_of_15mps":{"value":"280","unit":"km"}},"prediction":{"time":"2026-07-12T18:00:00+00:00","position":"32.20,117.50","gust":{"value":"23","unit":"m/s"},"pressure":{"value":"1000","unit":"hPa"},"max_winds":{"value":"15","unit":"m/s"},"radius_of_15mps":{"value":"-","unit":"km"}},"typhoon_name":"BAVI","cwa_typhoon_name":"巴威"}]}]},"web":"https://www.cwa.gov.tw/V8/C/P/Warning/FIFOWS.html","parameter":[{"valueName":"alert_title","value":"颱風警報"},{"valueName":"severity_level","value":"海上陸上颱風警報"},{"valueName":"alert_color","value":"紅色"},{"valueName":"website_color","value":"255,0,0"}],"area":[{"areaDesc":"臺灣北部海面","polygon":"25.000032,122.000000 25.000032,121.997200 25.006732,122.000000 25.114732,121.881700 25.126532,121.788600 25.138932,121.734700 25.168632,121.681300 25.214432,121.636700 25.249432,121.616900 25.259132,121.608900 25.267232,121.598000 25.275832,121.583300 25.283632,121.563200 25.282232,121.515300 25.277332,121.500000 25.270432,121.478300 25.243932,121.442700 25.236632,121.435300 25